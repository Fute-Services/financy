{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "cd .. && pnpm install --frozen-lockfile",
  "buildCommand": "cd .. && pnpm exec turbo run build --filter=@financy/api",

  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 60
    }
  },

  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],

  "regions": ["bom1"]
}
