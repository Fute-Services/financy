{
  "name": "financy",
  "version": "0.1.0",
  "private": true,
  "description": "Financy — company spend management and finance operations platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @financy/e2e test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @financy/db generate",
    "db:migrate": "pnpm --filter @financy/db migrate",
    "db:migrate:deploy": "pnpm --filter @financy/db migrate:deploy",
    "db:seed": "pnpm --filter @financy/db seed",
    "db:seed:system": "pnpm --filter @financy/db seed:system",
    "db:seed:demo": "pnpm --filter @financy/db seed:demo",
    "db:verify": "pnpm --filter @financy/db verify:constraints",
    "db:studio": "pnpm --filter @financy/db studio",
    "diagrams": "node scripts/gen-diagrams.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean && node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
