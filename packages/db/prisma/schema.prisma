// ═══════════════════════════════════════════════════════════════════════════
//  Financy — Prisma schema
//
//  Phase 1: identity, tenancy, and audit. No money yet — that is Phase 2, and
//  the build order is deliberate: an approval has no authority until identity
//  and permissions exist, so those come first.
//
//  Design rules every model here satisfies — docs/09-DATABASE-DESIGN.md §1:
//
//    · Primary keys are UUID v7, generated by the application (`newId()` in
//      `@financy/core`), never a column default. The application generates the
//      id so it can be logged and audited before the row is written.
//    · Every business table carries `organizationId`, mapped to
//      `organization_id`. `users`, `sessions`, `mfa_factors`, `permissions`
//      and `role_permissions` are the deliberate exceptions: a user is a
//      global identity holding memberships in several organisations.
//    · Every model is registered in `src/tenancy/model-registry.ts` as
//      tenant-scoped or global. A model in neither is refused at query time,
//      and a test asserts the registration.
//    · Cross-tenant references are structurally impossible: every tenant
//      parent exposes `@@unique([id, organizationId])` and every child
//      references it through that composite key, carrying its own
//      `organizationId`. A row cannot point at another organisation's record
//      even if application code tried (docs/09 §7.5).
//    · Timestamps are `timestamptz`; genuine calendar dates are `date`.
//    · Names are camelCase in Prisma and snake_case in PostgreSQL, mapped
//      explicitly.
//    · The first column of every composite index is `organizationId`, so
//      every query is tenant-anchored at the index level.
//
//  What this file cannot express, and where it lives instead:
//  CHECK constraints, partial unique indexes, and the `REVOKE UPDATE, DELETE`
//  on the immutable tables are appended to the generated migration by
//  `prisma/sql/01-constraints.sql`. Prisma has no syntax for them, and they
//  are not optional — see the migration README.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Enumerations
// ═══════════════════════════════════════════════════════════════════════════

/// Which rows a membership's permissions apply to (docs/03 §1.2).
/// Stored on the membership and applied by the repository layer as a
/// mandatory predicate. Never optional, never client-supplied.
enum MembershipScope {
  SELF
  DEPARTMENT
  ENTITY
  ORGANISATION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

/// Who performed an audited action. `SYSTEM` is a scheduled job, `PROVIDER` an
/// inbound webhook — both legitimately have no membership, which is why the
/// actor CHECK constraint only requires one for `USER`.
enum ActorType {
  USER
  SYSTEM
  PROVIDER
}

/// Second-factor kinds. Only TOTP is implemented; the enum exists so adding
/// WebAuthn later is a migration rather than a redesign.
enum MfaFactorType {
  TOTP
}

/// Security-relevant events, kept separate from the audit trail because they
/// answer a different question: the audit log says what changed, this says
/// who tried (docs/12 §7).
enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_ENROLLED
  MFA_CHALLENGE_FAILED
  SESSION_REVOKED
  ROLE_CHANGED
  MEMBERSHIP_DEACTIVATED
  TENANT_MISMATCH_ATTEMPTED
  STEP_UP_FAILED
}

// ═══════════════════════════════════════════════════════════════════════════
//  Global — identity that is not owned by any one organisation
// ═══════════════════════════════════════════════════════════════════════════

/// The tenant root.
///
/// Global rather than tenant-scoped for a structural reason: it *is* the
/// tenant, so scoping it by `organizationId` would be circular. Access is
/// controlled by the caller's membership instead.
model Organization {
  id   String @id @db.Uuid
  /// Case-insensitive and unique. Used in URLs and invitation emails, so
  /// `Acme` and `acme` must not be two different organisations.
  slug String @unique @db.Citext

  name      String
  legalName String? @map("legal_name")

  /// Locked once any financial record exists — changing it would silently
  /// reinterpret every stored amount (`409 CURRENCY_LOCKED`).
  baseCurrency String @map("base_currency") @db.Char(3)

  timezone             String @default("UTC")
  fiscalYearStartMonth Int    @default(1) @map("fiscal_year_start_month")
  countryCode          String @map("country_code") @db.Char(2)

  settings Json @default("{}") @db.JsonB

  /// Optimistic concurrency (docs/09 §1.7). A stale `If-Match` is a `409`.
  version Int @default(1)

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    Membership[]
  roles          Role[]
  entities       Entity[]
  departments    Department[]
  projects       Project[]
  categories     Category[]
  invitations    Invitation[]
  auditEvents    AuditEvent[]
  securityEvents SecurityEvent[]

  @@map("organizations")
}

/// A human, globally.
///
/// A user has **no permissions**. A membership does (docs/03 §1). Every
/// authorisation decision therefore starts by resolving the membership from
/// the session, which is what makes tenant isolation structural rather than
/// incidental.
model User {
  id String @id @db.Uuid

  /// `citext`, so `Ada@acme.com` and `ada@acme.com` are one account. Unique
  /// globally: one row per human, however many organisations they belong to.
  email String @unique @db.Citext

  /// argon2id. Never logged, never returned, never in an error message.
  passwordHash String @map("password_hash")

  fullName        String    @map("full_name")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)

  /// Lockout state. Counted per account rather than per IP, because an
  /// attacker rotates addresses and the account is what needs protecting.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships    Membership[]
  sessions       Session[]
  mfaFactors     MfaFactor[]
  securityEvents SecurityEvent[]

  @@map("users")
}

/// The global permission catalogue. Seeded, never written through an API.
///
/// `key` is `<resource>:<action>` and is stable forever — clients branch on
/// it, tests assert on it (docs/03 §1.1).
model Permission {
  id          String  @id @db.Uuid
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

/// A named bundle of permissions.
///
/// **Every organisation owns its own five roles.** The obvious alternative —
/// one shared set of system roles with a null `organizationId` — was tried
/// first and is broken: a membership references its role through the composite
/// key `(role_id, organization_id)`, and a row whose `organization_id` is NULL
/// can never match a membership whose organisation is not. No membership could
/// hold a system role at all. An integration test caught it (`memberships:
/// permits the same reference within one organisation`).
///
/// The fix is not to weaken the foreign key, because that key is what makes a
/// cross-tenant role assignment structurally impossible (docs/09 §1.2, §7.5).
/// It is to give each organisation its own copy, provisioned at registration
/// from the one catalogue in `@financy/contracts`. Five extra rows per tenant
/// buys a guarantee the application cannot violate — and makes the custom
/// roles of Phase 6 an insert rather than a migration.
///
/// `isSystem` marks the provisioned five, so a later deploy can reconcile them
/// without touching a role an organisation defined itself.
model Role {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  key         String
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  /// One role per key per organisation. No partial index needed now that
  /// `organization_id` is never NULL — the constraint says exactly what is
  /// meant, which the nullable version could not.
  @@unique([organizationId, key])
  /// Composite candidate key, so a membership's `(role_id, organization_id)`
  /// cannot point at another organisation's role.
  @@unique([id, organizationId])
  @@map("roles")
}

/// Join. Global because both sides are.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// An opaque server-side session.
///
/// Global via the user, because a session is opened before an organisation is
/// chosen — `activeMembershipId` is what binds it to one, and switching
/// organisations rewrites that rather than issuing a new token.
model Session {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  activeMembershipId String? @map("active_membership_id") @db.Uuid

  /// The **hash** of the token, never the token. A database disclosure must
  /// not hand the reader a set of working sessions.
  tokenHash Bytes @unique @map("token_hash")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Two expiries, because they defend against different things: idle against
  /// an unattended browser, absolute against a stolen token living forever.
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)

  /// Last successful re-authentication. A high-risk action requires this to
  /// be within `STEP_UP_WINDOW_MINUTES` (docs/12 §4).
  steppedUpAt DateTime? @map("stepped_up_at") @db.Timestamptz(6)

  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership Membership? @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([activeMembershipId])
  /// Drives the expiry sweep.
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// A second authentication factor.
///
/// Schema and service land in Phase 1 (task 1.3.6); the enrolment UI is
/// Phase 6, behind `FEATURE_MFA_ENROLLMENT`.
model MfaFactor {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid

  type MfaFactorType @default(TOTP)

  /// Encrypted with `ENCRYPTION_KEY`, never stored or logged in the clear —
  /// the secret is a password equivalent.
  secretEncrypted Bytes @map("secret_encrypted")

  /// Hashed, like passwords: a backup code is a credential.
  backupCodeHashes String[] @default([]) @map("backup_code_hashes")

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("mfa_factors")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Tenant-scoped — organisation structure
// ═══════════════════════════════════════════════════════════════════════════

/// A user's relationship to one organisation: role, department, manager, scope.
model Membership {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  departmentId         String? @map("department_id") @db.Uuid
  managerMembershipId  String? @map("manager_membership_id") @db.Uuid

  scope MembershipScope @default(SELF)

  /// Which legal entities this membership may see, when `scope = ENTITY`.
  /// An array rather than a join table because it is read on every request
  /// and never queried from the other side.
  entityScope String[] @default([]) @map("entity_scope") @db.Uuid

  status        MembershipStatus @default(ACTIVE)
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       Role        @relation(fields: [roleId, organizationId], references: [id, organizationId])
  department Department? @relation("DepartmentMembers", fields: [departmentId, organizationId], references: [id, organizationId])

  manager Membership?  @relation("ManagerChain", fields: [managerMembershipId, organizationId], references: [id, organizationId])
  reports Membership[] @relation("ManagerChain")

  sessions        Session[]
  headOf          Department[]  @relation("DepartmentHead")
  invitationsSent Invitation[]  @relation("InvitedBy")
  auditEvents     AuditEvent[]
  securityEvents  SecurityEvent[]

  /// One membership per user per organisation.
  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, roleId])
  @@index([userId])
  @@index([managerMembershipId, organizationId])
  @@map("memberships")
}

/// A legal entity. Each has its own functional currency.
model Entity {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name               String
  registrationNumber String? @map("registration_number")
  countryCode        String  @map("country_code") @db.Char(2)
  functionalCurrency String  @map("functional_currency") @db.Char(3)

  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("entities")
}

/// The department tree.
model Department {
  id             String  @id @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  parentId       String? @map("parent_id") @db.Uuid

  name String
  code String?

  headMembershipId String? @map("head_membership_id") @db.Uuid

  /// Materialised ancestry, `/root-id/child-id/`, maintained by the service.
  ///
  /// A recursive CTE would answer "this department and its descendants"
  /// correctly, but that question is asked on nearly every scoped read by a
  /// manager — so it is answered by a `LIKE 'path%'` index scan instead.
  /// The cost is that a re-parent has to rewrite the subtree's paths, which
  /// is rare and is done in one statement.
  path String

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parent   Department?  @relation("DepartmentTree", fields: [parentId, organizationId], references: [id, organizationId])
  children Department[] @relation("DepartmentTree")

  head    Membership?  @relation("DepartmentHead", fields: [headMembershipId, organizationId], references: [id, organizationId])
  members Membership[] @relation("DepartmentMembers")

  projects Project[]

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@index([organizationId, path])
  @@index([headMembershipId, organizationId])
  @@map("departments")
}

/// An optional cost dimension.
model Project {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name String
  code String?

  entityId     String? @map("entity_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid

  status     ProjectStatus @default(ACTIVE)
  startsOn   DateTime?     @map("starts_on") @db.Date
  endsOn     DateTime?     @map("ends_on") @db.Date
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity       Entity?      @relation(fields: [entityId, organizationId], references: [id, organizationId])
  department   Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([entityId, organizationId])
  @@index([departmentId, organizationId])
  @@map("projects")
}

/// The spend category tree. Seeded with defaults, extensible per organisation.
model Category {
  id             String  @id @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  parentId       String? @map("parent_id") @db.Uuid

  key  String
  name String

  /// Seeded categories are marked, so the system seed can stay idempotent and
  /// an organisation's own categories are never overwritten by a deploy.
  isSystem Boolean @default(false) @map("is_system")

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parent   Category?  @relation("CategoryTree", fields: [parentId, organizationId], references: [id, organizationId])
  children Category[] @relation("CategoryTree")

  @@unique([id, organizationId])
  @@unique([organizationId, key])
  @@index([organizationId, parentId])
  @@map("categories")
}

/// An invitation to join an organisation.
model Invitation {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  email  String @db.Citext
  roleId String @map("role_id") @db.Uuid

  departmentId String? @map("department_id") @db.Uuid

  invitedByMembershipId String @map("invited_by_membership_id") @db.Uuid

  /// Hashed, single-use, expiring. The plaintext exists only in the email.
  tokenHash Bytes @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  /// Soft delete: an invitation that was sent is evidence, even once spent.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  resentCount Int      @default(0) @map("resent_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId])
  invitedBy    Membership   @relation("InvitedBy", fields: [invitedByMembershipId, organizationId], references: [id, organizationId])

  @@unique([id, organizationId])
  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
  @@index([roleId, organizationId])
  @@index([invitedByMembershipId, organizationId])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Tenant-scoped — the immutable record
//
//  Neither of these has an UPDATE or DELETE path anywhere in the application,
//  and the database role has no grant for either (`01-constraints.sql`). The
//  absence is the control.
// ═══════════════════════════════════════════════════════════════════════════

/// Every privileged or financial mutation, written inside the caller's
/// transaction (docs/09 §7.1). Either the change and its audit event both
/// commit, or neither does.
model AuditEvent {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Null only when `actorType` is not `USER`, enforced by a CHECK
  /// constraint in `01-constraints.sql`. A job and a webhook legitimately
  /// have no membership; a user action never does.
  actorMembershipId String?   @map("actor_membership_id") @db.Uuid
  actorType         ActorType @default(USER) @map("actor_type")
  /// The job name or provider name, when the actor is not a person.
  actorLabel        String?   @map("actor_label")

  /// `spend_request.approved`, `membership.role_changed`, … Stable strings,
  /// quoted in support tickets and asserted on in tests.
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id") @db.Uuid

  /// The change itself. Both null for a read-style event such as an export.
  before Json? @db.JsonB
  after  Json? @db.JsonB

  metadata Json @default("{}") @db.JsonB

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  /// Joins the event to the request that produced it, and to every log line
  /// that request emitted.
  correlationId String @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id])
  actorMembership Membership? @relation(fields: [actorMembershipId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId, createdAt(sort: Desc)])
  @@index([organizationId, actorMembershipId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Who tried, as opposed to what changed.
///
/// Separate from `audit_events` because the questions differ and so do the
/// readers: a failed login has no resource and no before/after, and forcing it
/// into the audit shape would make both harder to query.
model SecurityEvent {
  id             String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  type SecurityEventType

  /// Both optional: a failed login for an unknown email has neither.
  userId       String? @map("user_id") @db.Uuid
  membershipId String? @map("membership_id") @db.Uuid

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  metadata Json @default("{}") @db.JsonB

  correlationId String @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  membership   Membership?  @relation(fields: [membershipId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("security_events")
}
