// ═══════════════════════════════════════════════════════════════════════════
//  Financy — Prisma schema (MongoDB)
//
//  ⚠ READ THIS BEFORE CHANGING ANYTHING HERE.
//
//  This schema targets MongoDB at the operator's direction. MongoDB cannot
//  express several guarantees the PostgreSQL schema enforced, and those
//  guarantees have not disappeared — they have **moved into application code**,
//  where they can be bypassed by any write that does not go through the
//  service layer. Each one is marked below.
//
//  What the database no longer enforces:
//
//    · **Cross-tenant references.** PostgreSQL used composite foreign keys
//      `(id, organization_id)` so a membership could not point at another
//      organisation's department even if the code tried. MongoDB has no
//      foreign keys and Prisma's Mongo connector has no multi-field relations,
//      so this is now a check in `TenantGuard` and the repositories.
//    · **CHECK constraints.** The audit actor rule, ISO-4217 and ISO-3166
//      formats, hierarchy self-reference, department path shape, session
//      expiry ordering, and the entity-scope rule are all validated in
//      `packages/contracts` and the services instead.
//    · **Immutability by grant.** `REVOKE UPDATE, DELETE ON audit_events` has
//      no equivalent for a single Atlas application user. `AuditService`
//      exposes no update or delete method, which is a convention rather than
//      a permission.
//    · **Migrations.** Prisma Migrate does not support MongoDB. Schema changes
//      are applied with `prisma db push`, so there is no ordered, reviewed SQL
//      file per change and no expand/contract path (`docs/09 §10`).
//    · **Case-insensitive email.** There is no `citext`. Uniqueness holds only
//      because `emailSchema` lower-cases before writing; a direct database
//      write bypasses it.
//
//  What still holds: unique indexes, compound indexes, `Decimal` for money,
//  and multi-document transactions (Atlas runs a replica set, so registration
//  stays atomic).
//
//  Conventions that remain unchanged:
//    · Primary keys are UUID v7 generated by the application (`newId()`),
//      stored as the string `_id`.
//    · Every business collection carries `organizationId`. `users`, `sessions`,
//      `mfaFactors`, `permissions`, and `rolePermissions` are the deliberate
//      exceptions — a user is a global identity.
//    · Every model must be registered in `src/tenancy/model-registry.ts`.
//    · The first field of every compound index is `organizationId`.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Enumerations
// ═══════════════════════════════════════════════════════════════════════════

/// Which documents a membership's permissions apply to (docs/03 §1.2).
enum MembershipScope {
  SELF
  DEPARTMENT
  ENTITY
  ORGANISATION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

/// Who performed an audited action. `SYSTEM` is a scheduled job, `PROVIDER` an
/// inbound webhook — both legitimately have no membership.
///
/// PostgreSQL enforced "a USER action names its actor" with a CHECK
/// constraint. Here it is enforced by `AuditService.record`, which throws
/// before writing.
enum ActorType {
  USER
  SYSTEM
  PROVIDER
}

enum MfaFactorType {
  TOTP
}

enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_ENROLLED
  MFA_CHALLENGE_FAILED
  SESSION_REVOKED
  ROLE_CHANGED
  MEMBERSHIP_DEACTIVATED
  TENANT_MISMATCH_ATTEMPTED
  STEP_UP_FAILED
}

// ═══════════════════════════════════════════════════════════════════════════
//  Global — identity that belongs to no single organisation
// ═══════════════════════════════════════════════════════════════════════════

/// The tenant root.
model Organization {
  id   String @id @map("_id")
  /// Unique, and lower-cased by the service before writing. PostgreSQL used
  /// `citext`, which made that a property of the column rather than of the
  /// code path.
  slug String @unique

  name      String
  legalName String?

  /// ISO-4217. Format was a CHECK constraint; it is now `currencyCodeSchema`.
  /// Locked once any financial record exists (`409 CURRENCY_LOCKED`).
  baseCurrency String

  timezone             String @default("UTC")
  fiscalYearStartMonth Int    @default(1)
  /// ISO-3166 alpha-2. Format validated in the contract, not the database.
  countryCode          String

  settings Json @default("{}")

  /// Optimistic concurrency (docs/09 §1.7). A stale `If-Match` is a `409`.
  version Int @default(1)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships    Membership[]
  roles          Role[]
  entities       Entity[]
  departments    Department[]
  projects       Project[]
  categories     Category[]
  invitations    Invitation[]
  auditEvents    AuditEvent[]
  securityEvents SecurityEvent[]

  policies            Policy[]
  policyVersions      PolicyVersion[]
  spendRequests       SpendRequest[]
  approvalInstances   ApprovalInstance[]
  approvalSteps       ApprovalStep[]
  approvalActions     ApprovalAction[]
  approvalDelegations ApprovalDelegation[]
  cards                  Card[]
  cardLimits             CardLimit[]
  transactions           Transaction[]
  transactionAdjustments TransactionAdjustment[]

  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  receipts                Receipt[]
  receiptAttachments      ReceiptAttachment[]
  expenses                Expense[]
  expenseItems            ExpenseItem[]
  reimbursementBatches    ReimbursementBatch[]
  reimbursementLines      ReimbursementLine[]

  @@map("organizations")
}

/// A human, globally.
///
/// A user has **no permissions**. A membership does (docs/03 §1).
model User {
  id String @id @map("_id")

  /// Unique. Case-insensitivity comes from `emailSchema` lower-casing before
  /// the write — MongoDB has no `citext`, so `Ada@acme.com` written directly
  /// to the collection would create a second account.
  email String @unique

  /// argon2id. Never logged, never returned, never in an error message.
  passwordHash String

  fullName        String
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Lockout state, counted per account rather than per IP: an attacker
  /// rotates addresses, and the account is what needs protecting.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships    Membership[]
  sessions       Session[]
  mfaFactors     MfaFactor[]
  securityEvents SecurityEvent[]

  @@map("users")
}

/// The global permission catalogue. Seeded, never written through an API.
model Permission {
  id          String  @id @map("_id")
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

/// A named bundle of permissions, owned by one organisation.
///
/// Per-organisation rather than shared, which was forced by the PostgreSQL
/// composite foreign key and is kept here deliberately even though MongoDB
/// would not force it: a shared role set means a role edit in one tenant is a
/// role edit in every tenant, and there is no way to offer custom roles in
/// Phase 6 without splitting them anyway.
model Role {
  id             String @id @map("_id")
  organizationId String

  key         String
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

/// Join between a role and a permission.
model RolePermission {
  id           String @id @map("_id")
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  /// PostgreSQL used `(role_id, permission_id)` as the primary key. MongoDB
  /// requires a single `_id`, so the pair becomes a unique index instead —
  /// the duplicate-grant guarantee survives, the shape does not.
  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// An opaque server-side session.
model Session {
  id     String @id @map("_id")
  userId String

  activeMembershipId String?

  /// The **hash** of the token, never the token itself.
  tokenHash Bytes @unique

  ipAddress String?
  userAgent String?

  lastSeenAt DateTime @default(now())

  /// Two expiries, defending against different things: idle against an
  /// unattended browser, absolute against a stolen token living forever.
  ///
  /// PostgreSQL enforced `idle <= absolute` with a CHECK. `SessionService`
  /// clamps instead.
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime

  /// Last successful re-authentication, for the step-up window (docs/12 §4).
  steppedUpAt DateTime?

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  user             User        @relation(fields: [userId], references: [id])
  activeMembership Membership? @relation(fields: [activeMembershipId], references: [id])

  @@index([userId, revokedAt])
  @@index([activeMembershipId])
  /// Drives the expiry sweep.
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// A second authentication factor. Enrolment UI is Phase 6.
model MfaFactor {
  id     String @id @map("_id")
  userId String

  type MfaFactorType @default(TOTP)

  /// Encrypted with `ENCRYPTION_KEY`. The secret is a password equivalent.
  secretEncrypted Bytes

  /// Hashed, like passwords: a backup code is a credential.
  backupCodeHashes String[] @default([])

  confirmedAt DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("mfa_factors")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Tenant-scoped
//
//  Every relation below was a **composite** foreign key under PostgreSQL,
//  carrying `organizationId` on both sides so a cross-tenant reference was
//  structurally impossible. MongoDB has no foreign keys and Prisma's Mongo
//  connector has no multi-field relations, so each is now a single-field
//  reference that the database will not check at all.
//
//  The predicate in the Prisma tenant extension is what keeps reads inside an
//  organisation. Writes are checked in the services. Neither survives a bug.
// ═══════════════════════════════════════════════════════════════════════════

/// A user's relationship to one organisation.
model Membership {
  id             String @id @map("_id")
  organizationId String
  userId         String
  roleId         String

  departmentId        String?
  managerMembershipId String?

  scope MembershipScope @default(SELF)

  /// Which legal entities this membership may see, when `scope = ENTITY`.
  /// PostgreSQL required at least one via CHECK; the service does now.
  entityScope String[] @default([])

  status        MembershipStatus @default(ACTIVE)
  deactivatedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  department   Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id])

  manager Membership?  @relation("ManagerChain", fields: [managerMembershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports Membership[] @relation("ManagerChain")

  sessions        Session[]
  headOf          Department[]    @relation("DepartmentHead")
  invitationsSent Invitation[]    @relation("InvitedBy")
  auditEvents     AuditEvent[]
  securityEvents  SecurityEvent[]

  policyVersionsAuthored PolicyVersion[]      @relation("PolicyAuthor")
  spendRequests          SpendRequest[]       @relation("SpendRequester")
  approvalActions        ApprovalAction[]     @relation("ApprovalActor")
  approvalActionsOnBehalf ApprovalAction[]    @relation("ApprovalDelegator")
  delegationsGiven       ApprovalDelegation[] @relation("DelegatedFrom")
  delegationsReceived    ApprovalDelegation[] @relation("DelegatedTo")

  cardsHeld              Card[]                  @relation("CardHolder")
  cardLimitsSet          CardLimit[]             @relation("CardLimitAuthor")
  transactions           Transaction[]           @relation("TransactionMember")
  transactionsReviewed   Transaction[]           @relation("TransactionReviewer")
  adjustmentsAuthored    TransactionAdjustment[] @relation("AdjustmentAuthor")

  notifications          Notification[]           @relation("NotificationRecipient")
  receiptsUploaded       Receipt[]                @relation("ReceiptUploader")
  expensesSubmitted      Expense[]                @relation("ExpenseSubmitter")
  reimbursementsReceived ReimbursementBatch[]     @relation("ReimbursementPayee")
  reimbursementsApproved ReimbursementBatch[]     @relation("ReimbursementApprover")
  reimbursementsPaid     ReimbursementBatch[]     @relation("ReimbursementPayer")
  receiptsAttached       ReceiptAttachment[]      @relation("ReceiptAttacher")
  receiptsDetached       ReceiptAttachment[]      @relation("ReceiptDetacher")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceOwner")

  /// One membership per user per organisation.
  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, roleId])
  @@index([userId])
  @@index([managerMembershipId])
  @@map("memberships")
}

/// A legal entity, with its own functional currency.
model Entity {
  id             String @id @map("_id")
  organizationId String

  name               String
  registrationNumber String?
  countryCode        String
  functionalCurrency String

  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  projects      Project[]
  spendRequests SpendRequest[]
  cards         Card[]
  transactions  Transaction[]
  expenses      Expense[]
  reimbursementBatches ReimbursementBatch[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("entities")
}

/// The department tree.
model Department {
  id             String  @id @map("_id")
  organizationId String
  parentId       String?

  name String
  code String?

  headMembershipId String?

  /// Materialised ancestry, `/root-id/child-id/`, maintained by the service.
  ///
  /// Subtree reads are `path startsWith '/a/b/'`. PostgreSQL had a CHECK that
  /// the path was delimited at both ends, because an undelimited one makes
  /// '/a/bc/' match a query for '/a/b/' and silently widens a manager's scope.
  /// That check is now in the department service.
  path String

  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Department[] @relation("DepartmentTree")

  /// `NoAction` breaks the cycle Prisma detects: a membership points at its
  /// department, and a department points at its head membership. Referential
  /// actions are advisory here anyway — MongoDB does not enforce them — so
  /// the head is cleared by the service when a membership is deactivated.
  head    Membership?  @relation("DepartmentHead", fields: [headMembershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members Membership[] @relation("DepartmentMembers")

  projects      Project[]
  spendRequests SpendRequest[]
  cards         Card[]
  transactions  Transaction[]
  expenses      Expense[]

  /// **Not** unique on (organizationId, code), though PostgreSQL made it so.
  /// MongoDB treats every missing or null value in a unique index as the same
  /// value, so a second row without a code collides with the first — an
  /// organisation could have exactly one uncoded department, which is not a
  /// rule anybody asked for. Uniqueness of a code that *is* set is enforced by
  /// the service instead.
  @@index([organizationId, code])
  @@index([organizationId, parentId])
  @@index([organizationId, path])
  @@index([headMembershipId])
  @@map("departments")
}

/// An optional cost dimension.
model Project {
  id             String @id @map("_id")
  organizationId String

  name String
  code String?

  entityId     String?
  departmentId String?

  status     ProjectStatus @default(ACTIVE)
  startsOn   DateTime?
  endsOn     DateTime?
  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  entity        Entity?        @relation(fields: [entityId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  spendRequests SpendRequest[]
  transactions  Transaction[]
  expenses      Expense[]

  /// **Not** unique on (organizationId, code), though PostgreSQL made it so.
  /// MongoDB treats every missing or null value in a unique index as the same
  /// value, so a second row without a code collides with the first — an
  /// organisation could have exactly one uncoded department, which is not a
  /// rule anybody asked for. Uniqueness of a code that *is* set is enforced by
  /// the service instead.
  @@index([organizationId, code])
  @@index([organizationId, status])
  @@index([entityId])
  @@index([departmentId])
  @@map("projects")
}

/// The spend category tree.
model Category {
  id             String  @id @map("_id")
  organizationId String
  parentId       String?

  key  String
  name String

  /// Seeded categories are marked, so a deploy never overwrites an
  /// organisation's own.
  isSystem Boolean @default(false)

  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  spendRequests SpendRequest[]
  transactions  Transaction[]
  expenses      Expense[]
  expenseItems  ExpenseItem[]

  @@unique([organizationId, key])
  @@index([organizationId, parentId])
  @@map("categories")
}

/// An invitation to join an organisation.
model Invitation {
  id             String @id @map("_id")
  organizationId String

  email  String
  roleId String

  departmentId String?

  invitedByMembershipId String

  /// Hashed, single-use, expiring. The plaintext exists only in the email.
  tokenHash Bytes @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  /// Soft delete: an invitation that was sent is evidence, even once spent.
  deletedAt DateTime?

  resentCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    Membership   @relation("InvitedBy", fields: [invitedByMembershipId], references: [id])

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
  @@index([roleId])
  @@index([invitedByMembershipId])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════════════════════════════
//  The record that is supposed to be immutable
//
//  Under PostgreSQL the application role had no UPDATE or DELETE grant on
//  these two tables, so tampering failed at the database regardless of what
//  the code did. A single Atlas application user cannot express that, so
//  immutability here rests on `AuditService` and `SecurityEventService`
//  exposing no method that could rewrite a row. That is a convention. It is
//  weaker, and it is the most significant thing lost in this migration.
// ═══════════════════════════════════════════════════════════════════════════

/// Every privileged or financial mutation, written inside the caller's
/// transaction (docs/09 §7.1).
model AuditEvent {
  id             String @id @map("_id")
  organizationId String

  /// Null only when `actorType` is not `USER`. PostgreSQL enforced that with
  /// the `audit_actor_present` CHECK; `AuditService.record` throws instead.
  actorMembershipId String?
  actorType         ActorType @default(USER)
  /// The job name or provider name, when the actor is not a person.
  actorLabel        String?

  /// `spend_request.approved`, `membership.role_changed`, …
  action       String
  resourceType String
  resourceId   String?

  /// The change itself. Both null for a read-style event such as an export.
  before Json?
  after  Json?

  metadata Json @default("{}")

  ipAddress String?
  userAgent String?

  /// Joins the event to the request that produced it, and to every log line
  /// that request emitted.
  correlationId String

  createdAt DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  actorMembership Membership?  @relation(fields: [actorMembershipId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId, createdAt(sort: Desc)])
  @@index([organizationId, actorMembershipId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Who tried, as opposed to what changed (docs/12 §7).
model SecurityEvent {
  id             String @id @map("_id")
  organizationId String

  type SecurityEventType

  /// Both optional: a failed login for an unknown email has neither.
  userId       String?
  membershipId String?

  ipAddress String?
  userAgent String?

  metadata Json @default("{}")

  correlationId String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  membership   Membership?  @relation(fields: [membershipId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("security_events")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Phase 2 — policy, approvals, spend requests
//
//  Two shapes here are unusual and both are deliberate.
//
//  **A policy version stores its rules as JSON, not as rows.** `policy_rules`
//  exists in the PostgreSQL design as a child table; here the version carries
//  a `snapshot` containing the whole rule set, validated by
//  `policyVersionSchema` on the way in. The reason is immutability: a version
//  is frozen the moment it is published, and a decision made under it must
//  remain explicable years later. Rules as rows can be edited one at a time by
//  anything holding a connection; a snapshot cannot be half-changed.
//
//  **Every spend record keeps its `policy_decision` verbatim.** It is never
//  recomputed for display. The screen answering "why did this need three
//  approvals?" reads the snapshot taken at submission, under the engine
//  version recorded in it — recomputing would answer with today's policy and
//  quietly be wrong about the past.
// ═══════════════════════════════════════════════════════════════════════════

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SpendType {
  CARD
  REIMBURSEMENT
  BILL
  PURCHASE_ORDER
  SPEND_REQUEST
}

/// A named spending policy. Its rules live on its versions.
model Policy {
  id             String @id @map("_id")
  organizationId String

  name        String
  description String?

  /// Which spend types this policy applies to. An empty list means none, not
  /// all — a policy that applied to everything by omission would be a policy
  /// nobody meant to write.
  spendTypes SpendType[]

  /// Higher runs first. Ties are broken by policy id in the evaluator, never
  /// by insertion order (docs/11 §5).
  priority Int @default(100)

  status PolicyStatus @default(DRAFT)

  /// The published version. Null while the policy has only drafts.
  currentVersionId String?

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  versions     PolicyVersion[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("policies")
}

/// One frozen revision of a policy's rules.
model PolicyVersion {
  id             String @id @map("_id")
  organizationId String
  policyId       String

  version Int

  /// The complete rule set, validated by `policyVersionSchema` before it is
  /// written. Frozen on publication — see the note at the top of this block.
  snapshot Json

  createdByMembershipId String?

  /// Why these rules changed. Written at publication and read by whoever asks,
  /// six months later, why a decision citing this version came out as it did —
  /// the only free-text record of intent a rule set carries.
  note String?

  /// Published, and therefore immutable. A draft version may still change.
  publishedAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  policy       Policy       @relation(fields: [policyId], references: [id])
  createdBy    Membership?  @relation("PolicyAuthor", fields: [createdByMembershipId], references: [id])

  @@unique([policyId, version])
  @@index([organizationId, policyId])
  @@map("policy_versions")
}

enum SpendRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  /// An approver returned it for changes. Editable again, and resubmitting
  /// re-evaluates policy from scratch — the amount may have changed, and
  /// reusing the old chain would launder a larger amount through a smaller
  /// approval (docs/11 §7.1).
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

/// A request to spend money, before any money moves.
model SpendRequest {
  id             String @id @map("_id")
  organizationId String

  /// Human-facing, unique per organisation — the thing people quote to each
  /// other. Numbered within the organisation rather than globally, so one
  /// customer's volume is not visible to another.
  reference String

  requesterMembershipId String

  entityId     String
  departmentId String?
  projectId    String?
  categoryId   String?
  vendorId     String?

  spendType SpendType @default(SPEND_REQUEST)

  /// A decimal string. Prisma's MongoDB connector has no `Decimal`, and a
  /// float amount is a rounding error waiting for a total (ADR-0017).
  amount   String
  currency String

  /// The same amount in the organisation's base currency, converted at a
  /// recorded rate. Policies are authored against this so that a rule never
  /// has to compare across currencies.
  amountInBaseCurrency String
  exchangeRate         String?

  purpose  String
  memo     String?
  neededBy DateTime?

  status SpendRequestStatus @default(DRAFT)

  /// The decision, verbatim, as it was made. Never recomputed.
  policyDecision Json?

  approvalInstanceId String?

  validUntil  DateTime?
  submittedAt DateTime?
  decidedAt   DateTime?

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  requester    Membership   @relation("SpendRequester", fields: [requesterMembershipId], references: [id])
  entity       Entity       @relation(fields: [entityId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])

  transactions Transaction[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, requesterMembershipId, status])
  @@index([organizationId, departmentId, status])
  @@index([requesterMembershipId])
  @@index([entityId])
  @@index([departmentId])
  @@index([projectId])
  @@index([categoryId])
  @@map("spend_requests")
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  /// Finance settled a stalled chain directly, with a mandatory reason.
  OVERRIDDEN
  EXPIRED
}

enum ApprovalStepStatus {
  WAITING
  ACTIVE
  APPROVED
  REJECTED
  /// Past its due date and reassigned. Still actionable — an escalated step
  /// that stopped accepting approvals would be a chain nobody can finish.
  ESCALATED
  RETURNED
  SKIPPED
  EXPIRED
}

enum ApprovalStepType {
  SINGLE
  PARALLEL_ANY
  PARALLEL_ALL
  QUORUM
}

enum ApprovalActionType {
  APPROVE
  REJECT
  RETURN
  DELEGATE
  OVERRIDE
}

/// One approval chain, for one subject.
model ApprovalInstance {
  id             String @id @map("_id")
  organizationId String

  /// `spend_request`, `expense`, `bill`, `purchase_order`. Polymorphic rather
  /// than one instance table per subject, because the state machine, the
  /// actions, and the queue endpoint are identical for all of them and three
  /// copies would drift.
  subjectType String
  subjectId   String

  status ApprovalInstanceStatus @default(PENDING)

  currentStepSequence Int @default(1)

  /// A copy of the decision the chain was built from. The instance outlives
  /// the policy version that produced it, and "why was this the chain?" has
  /// to stay answerable after the policy changes.
  policyDecisionSnapshot Json

  completedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  steps        ApprovalStep[]

  @@index([organizationId, status])
  @@index([organizationId, subjectType, subjectId])
  @@map("approval_instances")
}

model ApprovalStep {
  id                 String @id @map("_id")
  organizationId     String
  approvalInstanceId String

  sequence Int
  stepType ApprovalStepType

  /// How many approvals a `QUORUM` step needs. Ignored by the other types.
  quorum Int @default(1)

  status ApprovalStepStatus @default(WAITING)

  /// The memberships eligible to act, resolved from the approver specs when
  /// the chain was built. Stored rather than re-resolved: somebody eligible
  /// when the request was raised stays eligible, so a reorganisation midway
  /// through does not silently move the decision to another person.
  eligibleMembershipIds String[] @default([])

  activatedAt DateTime?
  dueAt       DateTime?
  completedAt DateTime?

  /// Who this step goes to if nobody acts before `dueAt`, resolved when the
  /// chain opened and frozen with everything else about the step:
  /// `{ afterHours, membershipIds }`.
  ///
  /// Frozen rather than resolved at escalation time for the same reason the
  /// eligible set is — a reorganisation between the submission and the
  /// deadline would otherwise move the escalation to somebody the policy
  /// author never named.
  escalation  Json?
  escalatedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  instance     ApprovalInstance @relation(fields: [approvalInstanceId], references: [id])
  actions      ApprovalAction[]

  @@unique([approvalInstanceId, sequence])
  @@index([organizationId, status])
  @@index([approvalInstanceId])
  @@map("approval_steps")
}

/// What somebody did to a step. Append-only, like the audit trail.
model ApprovalAction {
  id             String @id @map("_id")
  organizationId String
  approvalStepId String

  actedByMembershipId String

  /// Set when the actor was using delegated authority, so the record shows
  /// both who pressed the button and whose authority they used.
  onBehalfOfMembershipId String?

  action  ApprovalActionType
  comment String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  step         ApprovalStep @relation(fields: [approvalStepId], references: [id])
  actedBy      Membership   @relation("ApprovalActor", fields: [actedByMembershipId], references: [id])
  onBehalfOf   Membership?  @relation("ApprovalDelegator", fields: [onBehalfOfMembershipId], references: [id])

  @@index([organizationId, approvalStepId])
  @@index([actedByMembershipId])
  @@index([onBehalfOfMembershipId])
  @@map("approval_actions")
}

/// One person's approval authority, lent to another for a period.
model ApprovalDelegation {
  id             String @id @map("_id")
  organizationId String

  fromMembershipId String
  toMembershipId   String

  startsAt DateTime
  endsAt   DateTime

  reason String?

  revokedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  from         Membership   @relation("DelegatedFrom", fields: [fromMembershipId], references: [id])
  to           Membership   @relation("DelegatedTo", fields: [toMembershipId], references: [id])

  @@index([organizationId, fromMembershipId])
  @@index([organizationId, toMembershipId])
  @@index([toMembershipId])
  @@map("approval_delegations")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Cards and transactions (Phase 2, epic 2.4)
//
//  ⚠ **No model here ever holds a PAN, a CVV, or a full expiry date.**
//  Not "we redact it before logging" — the columns do not exist, so there is
//  no code path that could store one and no backup that could leak one. What
//  is stored is a provider reference, the last four digits, and the expiry
//  month and year: everything a person needs to recognise their own card and
//  nothing anybody could spend with. Card data lives with the issuer, behind
//  the `CardProvider` port (docs/13, ADR-0014).
// ═══════════════════════════════════════════════════════════════════════════

enum CardType {
  VIRTUAL
  PHYSICAL
}

enum CardStatus {
  /// Requested from the provider; not yet usable.
  PENDING
  ACTIVE
  /// Temporarily unusable, and reversible — which is why it is distinct from
  /// termination. Freezing a card somebody has mislaid must not throw away the
  /// card they will find in an hour.
  FROZEN
  /// Permanent. A terminated card is never reactivated: the provider has
  /// destroyed the credential, and pretending otherwise would leave a card
  /// that looks alive and declines every charge.
  TERMINATED
}

/// How often a card limit resets.
enum LimitPeriod {
  PER_TRANSACTION
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  /// Never resets. The card carries a lifetime ceiling.
  TOTAL
}

/// A spending authorisation, not a payment credential.
model Card {
  id             String @id @map("_id")
  organizationId String

  /// What people call it. "Marketing — ad spend", not a number.
  name String

  cardType CardType   @default(VIRTUAL)
  status   CardStatus @default(PENDING)

  holderMembershipId String
  entityId           String
  departmentId       String?
  projectId          String?
  categoryId         String?

  /// The policy that governs spend on this card, when one is named explicitly.
  /// Null means the organisation's ordinary policy set applies.
  policyId String?

  /// The **current** limit, denormalised from the newest `CardLimit` row so a
  /// list of cards does not need a join per row. `card_limits` remains the
  /// record; this is a cache of its latest value, written in the same
  /// transaction that writes the row.
  limitAmount   String
  limitCurrency String
  limitPeriod   LimitPeriod @default(MONTHLY)

  /// Everything the issuer knows and this system does not.
  provider       String
  providerCardId String?

  /// Enough to recognise a card. Never enough to use one.
  lastFour    String?
  expiryMonth Int?
  expiryYear  Int?

  validFrom  DateTime?
  validUntil DateTime?

  /// Why it was frozen or terminated. Shown to the holder, who otherwise has a
  /// card that stopped working with no explanation.
  statusReason String?

  version    Int       @default(1)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  holder       Membership   @relation("CardHolder", fields: [holderMembershipId], references: [id])
  entity       Entity       @relation(fields: [entityId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  limits       CardLimit[]
  transactions Transaction[]

  @@unique([organizationId, provider, providerCardId])
  @@index([organizationId, status])
  @@index([organizationId, holderMembershipId])
  @@index([holderMembershipId])
  @@index([entityId])
  @@index([departmentId])
  @@map("cards")
}

/// One limit, as it was set. Append-only.
///
/// The history is the point. "Who raised this card to 50,000 and when?" is a
/// question an auditor asks and an `UPDATE` cannot answer — so a change writes
/// a row rather than editing one, and the card's denormalised limit is the
/// newest row's value.
model CardLimit {
  id             String @id @map("_id")
  organizationId String
  cardId         String

  amount   String
  currency String
  period   LimitPeriod

  reason String?

  setByMembershipId String?
  effectiveFrom     DateTime @default(now())

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  card         Card         @relation(fields: [cardId], references: [id])
  setBy        Membership?  @relation("CardLimitAuthor", fields: [setByMembershipId], references: [id])

  @@index([organizationId, cardId, effectiveFrom])
  @@index([cardId])
  @@index([setByMembershipId])
  @@map("card_limits")
}

/// Where a transaction came from.
enum TransactionSource {
  CARD
  IMPORT
  MANUAL
  PROVIDER
}

/// Has the money moved?
enum TransactionStatus {
  /// Authorised, not settled. The amount can still change.
  PENDING
  /// Settled. Financial fields are immutable from here (docs/09 §7.2).
  POSTED
  /// The authorisation lapsed or was refused. No money moved.
  DECLINED
  REVERSED
}

/// Is there evidence?
enum ReceiptStatus {
  NOT_REQUIRED
  MISSING
  REQUESTED
  ATTACHED
}

/// Has finance looked at it?
enum ReviewStatus {
  PENDING
  IN_REVIEW
  REVIEWED
  /// Reviewed and found wrong. Distinct from `PENDING`, because "nobody has
  /// looked" and "somebody looked and disagreed" are different queues with
  /// different next actions.
  DISPUTED
}

/// Is it coded and exported?
enum AccountingStatus {
  UNMAPPED
  MAPPED
  EXPORTED
}

/// Did it match an authorisation?
enum MatchStatus {
  UNMATCHED
  /// Matched automatically — marked as such so a human can tell a guess from
  /// a decision, and reverse it without wondering who made it.
  AUTO_MATCHED
  MANUALLY_MATCHED
  /// Deliberately matched to nothing: a genuine unplanned purchase.
  NOT_APPLICABLE
}

/// Money that has actually moved.
///
/// **Four independent status axes**, and the independence is the design. A
/// transaction can be posted, missing its receipt, unreviewed, and unmapped all
/// at once — which is the ordinary state of a card charge on the day it lands.
/// Collapsing them into one `status` column forces an order on four processes
/// that genuinely run in parallel, and produces a list nobody can filter
/// usefully.
model Transaction {
  id             String @id @map("_id")
  organizationId String

  entityId           String
  cardId             String?
  memberMembershipId String?
  departmentId       String?
  projectId          String?
  categoryId         String?
  vendorId           String?

  /// The authorisation this fulfils, if any. Set by auto-match on import.
  spendRequestId String?

  /// Cleaned for display; `merchantRaw` is exactly what the provider sent.
  /// Both, because the cleaned one is what people search and the raw one is
  /// what an investigation needs on the day the cleaning was wrong.
  merchantName         String
  merchantRaw          String?
  merchantCategoryCode String?

  /// A decimal string. Prisma's MongoDB connector has no `Decimal`, and a
  /// float amount is a rounding error waiting for a total (ADR-0017).
  amount   String
  currency String

  /// What the organisation was actually billed, in its own currency.
  billingAmount   String?
  billingCurrency String?

  /// Recorded together or not at all. A converted amount whose rate nobody can
  /// reproduce is a number that cannot be checked.
  fxRate       String?
  fxRateSource String?
  fxRateAsOf   DateTime?

  source           TransactionSource @default(CARD)
  status           TransactionStatus @default(PENDING)
  receiptStatus    ReceiptStatus     @default(MISSING)
  reviewStatus     ReviewStatus      @default(PENDING)
  accountingStatus AccountingStatus  @default(UNMAPPED)
  matchStatus      MatchStatus       @default(UNMATCHED)

  memo String?

  /// When the money moved, as the merchant saw it. Distinct from `postedAt`,
  /// which is when it settled, and from `createdAt`, which is when this system
  /// first heard about it. Reports that conflate the three drift by days.
  occurredAt DateTime
  postedAt   DateTime?

  reviewedByMembershipId String?
  reviewedAt             DateTime?
  reviewNote             String?

  provider              String
  providerTransactionId String

  /// Everything the provider sent, verbatim. The one place a field nobody has
  /// modelled yet survives, which is what makes a reconciliation possible
  /// before the schema catches up.
  providerPayload Json?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  entity       Entity        @relation(fields: [entityId], references: [id])
  card         Card?         @relation(fields: [cardId], references: [id])
  member       Membership?   @relation("TransactionMember", fields: [memberMembershipId], references: [id])
  reviewedBy   Membership?   @relation("TransactionReviewer", fields: [reviewedByMembershipId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  spendRequest SpendRequest? @relation(fields: [spendRequestId], references: [id])

  adjustments TransactionAdjustment[]
  expenses    Expense[]

  /// The idempotency guarantee for imports. Re-running the same file writes
  /// nothing new, because every row carries the provider's own identifier and
  /// this index refuses the second copy.
  @@unique([organizationId, provider, providerTransactionId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, reviewStatus])
  @@index([organizationId, receiptStatus])
  @@index([organizationId, cardId, occurredAt])
  @@index([organizationId, departmentId, occurredAt])
  @@index([organizationId, categoryId, occurredAt])
  @@index([cardId])
  @@index([entityId])
  @@index([memberMembershipId])
  @@index([reviewedByMembershipId])
  @@index([departmentId])
  @@index([projectId])
  @@index([categoryId])
  @@index([spendRequestId])
  @@map("transactions")
}

/// A correction to a posted transaction, as a new linked row.
///
/// Never an edit. A posted transaction's financial fields are immutable
/// (docs/09 §1.6) because somebody has already reconciled against them, and a
/// correction that rewrote the original would silently change a figure that
/// has been reported.
model TransactionAdjustment {
  id             String @id @map("_id")
  organizationId String
  transactionId  String

  /// `REFUND`, `CHARGEBACK`, `FEE`, `CORRECTION`.
  adjustmentType String

  amount   String
  currency String

  reason String

  createdByMembershipId String?
  createdAt             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  transaction  Transaction  @relation(fields: [transactionId], references: [id])
  createdBy    Membership?  @relation("AdjustmentAuthor", fields: [createdByMembershipId], references: [id])

  @@index([organizationId, transactionId])
  @@index([transactionId])
  @@index([createdByMembershipId])
  @@map("transaction_adjustments")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Notifications and jobs (epic 2.5, docs/14)
// ═══════════════════════════════════════════════════════════════════════════

/// One thing somebody needs to know about, addressed to one membership.
///
/// **Addressed to a membership, not a user.** The same person in two
/// organisations must not see one organisation's approvals while looking at
/// the other, and a notification keyed by user would have no tenant to be
/// scoped by.
///
/// **Rendered when it is written, not when it is read.** The title and body
/// are stored as text, because a notification that rendered from its resource
/// at read time would change wording — or vanish — when the thing it refers to
/// changes. "Your €4,000 request was approved" must still say that after the
/// request is amended to €40.
model Notification {
  id                     String @id @map("_id")
  organizationId         String
  recipientMembershipId  String

  /// One of `NOTIFICATION_EVENTS` in `@financy/contracts`. Not an enum in the
  /// schema: the catalogue grows every phase, and a Prisma enum would make
  /// adding an event type a schema migration rather than a code change.
  eventType String

  /// What makes redelivery a no-op.
  ///
  /// The queue's idempotency key stops a job running twice; this stops a job
  /// that failed *halfway* from writing a second copy for the recipients it
  /// already reached. Requirement 1 of the job contract asks for a unique
  /// constraint on the effect rather than trust in exactly-once delivery, and
  /// the effect is this row.
  dedupeKey String

  title String
  body  String

  /// Where the notification points. Nullable because a digest points at a
  /// screen rather than at one record.
  resourceType String?
  resourceId   String?

  /// `IN_APP`, `EMAIL` — what was actually delivered, not what was intended.
  /// An email that failed every retry must not leave a record claiming it was
  /// sent.
  channelsDelivered String[] @default([])

  /// Anything the screen needs that is not in the text — an amount to format,
  /// a status to colour. Never the source of truth for the wording.
  metadata Json?

  readAt    DateTime?
  /// Soft delete (docs/09 §4): dismissing removes it from the list and keeps
  /// the record, so "I never got told" is answerable.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  recipient    Membership   @relation("NotificationRecipient", fields: [recipientMembershipId], references: [id])

  @@unique([recipientMembershipId, dedupeKey])
  @@index([organizationId, recipientMembershipId, readAt, createdAt])
  @@index([organizationId, recipientMembershipId, createdAt])
  @@index([recipientMembershipId])
  @@map("notifications")
}

/// What one person wants to be told about, and how.
///
/// A row exists only where somebody has changed something. The absence of a
/// row means the defaults in `@financy/contracts` apply — storing a row per
/// member per event type at registration would be thirty rows nobody chose,
/// and would freeze today's defaults for every account created before a
/// default changed.
model NotificationPreference {
  id             String @id @map("_id")
  organizationId String
  membershipId   String

  eventType String

  inApp Boolean @default(true)
  email Boolean @default(true)

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  membership   Membership   @relation("NotificationPreferenceOwner", fields: [membershipId], references: [id])

  /// One preference per member per event type. This is what makes a
  /// preference write an upsert rather than a read-then-insert that races.
  @@unique([membershipId, eventType])
  @@index([organizationId, membershipId])
  @@map("notification_preferences")
}

/// One attempt at one job, and the thing that makes delivery idempotent.
///
/// **The unique index on `(jobName, idempotencyKey)` is the guarantee**, not
/// the check that precedes it. A queue promises at-least-once delivery; two
/// deliveries of the same job arriving at the same moment both find nothing
/// when they look, and the second insert is what refuses. Reserving the row
/// *before* the handler runs is deliberate — reserving afterwards would let
/// both copies run and only then discover they were duplicates.
///
/// The row is kept after success: `job_executions` is where "did the
/// notification for step X ever go out?" is answered, and a table that only
/// held failures could not answer it.
model JobExecution {
  id String @id @map("_id")

  jobName        String
  idempotencyKey String

  /// Nullable because a few jobs are genuinely cross-tenant (a nightly sweep
  /// that fans out per organisation). Every job that touches tenant data
  /// carries one and establishes a request context from it.
  organizationId String?

  /// `RESERVED`, `SUCCEEDED`, `FAILED`, `DEAD_LETTERED`.
  status String @default("RESERVED")

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  payload Json

  /// The final error, classified. A permanent failure dead-letters on the
  /// first attempt — retrying a validation error five times is pure waste and
  /// delays the alert (docs/14 §3).
  errorMessage String?
  errorKind    String?

  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobName, idempotencyKey])
  @@index([status, scheduledFor])
  @@index([organizationId, jobName, createdAt])
  @@map("job_executions")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Receipts (epic 3.1)
// ═══════════════════════════════════════════════════════════════════════════

/// A file somebody uploaded as evidence of spend.
///
/// **The row exists before the file does.** An upload intent writes it as
/// `PENDING` and hands back a signed URL; the bytes arrive at storage without
/// passing through this API. A row with no object is the ordinary outcome of
/// somebody closing a tab, and it must be distinguishable from a receipt whose
/// file has gone missing — which is why `PENDING` is a status rather than an
/// absence.
///
/// **Nothing here is taken from the client.** `contentType` is what the file's
/// own first bytes say it is, `byteSize` and `checksum` are read from the
/// stored object, and `fileName` is the only field the uploader chooses — kept
/// for display and never used to build a storage key.
model Receipt {
  id             String @id @map("_id")
  organizationId String

  uploaderMembershipId String

  /// `{organizationId}/{receiptId}`. Generated, never derived from a file
  /// name: a key built from user input is a path traversal waiting to happen,
  /// and it leaks — `dana-therapy-invoice.pdf` says more than anybody meant.
  storageKey String

  /// What the person called it. Shown, never trusted, never a path.
  fileName String

  /// Decided by reading the file, not by believing the upload (FR-EXP-004).
  contentType String

  byteSize Int    @default(0)
  checksum String?

  status     String @default("PENDING")
  scanStatus String @default("PENDING")
  ocrStatus  String @default("PENDING")

  /// What OCR extracted, if anything. Suggestions for a human, never the
  /// source of truth for an amount (FR-EXP-011).
  ocrFields Json?

  /// Denormalised from the open attachment, so a list of forty receipts does
  /// not need forty history queries. The history rows are the record; this is
  /// a cache of the newest one, written in the same transaction.
  attachedTargetType String?
  attachedTargetId   String?

  storedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  uploader     Membership          @relation("ReceiptUploader", fields: [uploaderMembershipId], references: [id])
  attachments  ReceiptAttachment[]

  /// One receipt, one object. A second row pointing at the same key would let
  /// deleting one receipt take another one's file with it.
  @@unique([storageKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, attachedTargetType, attachedTargetId])
  @@index([uploaderMembershipId])
  @@map("receipts")
}

/// Where a receipt has been attached, including where it no longer is.
///
/// Append-only. "This receipt used to be on another expense" is a question an
/// auditor asks, and a system that only knows the current attachment cannot
/// answer it (FR-EXP-007).
model ReceiptAttachment {
  id             String @id @map("_id")
  organizationId String
  receiptId      String

  /// `expense` or `transaction`.
  targetType String
  targetId   String

  attachedByMembershipId String
  attachedAt             DateTime @default(now())

  detachedByMembershipId String?
  detachedAt             DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  receipt      Receipt      @relation(fields: [receiptId], references: [id])
  attachedBy   Membership   @relation("ReceiptAttacher", fields: [attachedByMembershipId], references: [id])
  detachedBy   Membership?  @relation("ReceiptDetacher", fields: [detachedByMembershipId], references: [id])

  @@index([organizationId, receiptId])
  @@index([organizationId, targetType, targetId])
  @@index([receiptId])
  @@index([attachedByMembershipId])
  @@index([detachedByMembershipId])
  @@map("receipt_attachments")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Expenses and reimbursements (epics 3.2, 3.3)
// ═══════════════════════════════════════════════════════════════════════════

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  /// Approved, batched, and paid. Terminal, and the only status a
  /// reimbursement line may point at.
  REIMBURSED
}

/// Money somebody has already spent, asking to have it recognised.
///
/// **The opposite of a spend request in one important way.** A spend request
/// asks *before*; an expense reports *after*, and the money is already gone.
/// That is why a rejected expense is a conversation rather than a control: it
/// does not stop the spending, it refuses the reimbursement — and the two are
/// different enough that collapsing them into one record would make the word
/// "rejected" mean two things.
///
/// **How it was paid decides what approval is for.** Out of pocket, approval
/// authorises paying somebody back. On a company card, the money has already
/// left the company and approval is a review — so the two carry different
/// spend types into the policy engine and can be governed by different rules.
model Expense {
  id             String @id @map("_id")
  organizationId String

  /// Human-facing, sequential per organisation: `EXP-00042`.
  reference String

  submitterMembershipId String

  /// `OUT_OF_POCKET` or `COMPANY_CARD`.
  paymentMethod String @default("OUT_OF_POCKET")

  /// Set when this expense explains a card charge. The link is what stops the
  /// same spend being both reimbursed and paid by the company.
  transactionId String?

  entityId     String
  departmentId String?
  projectId    String?
  categoryId   String?

  merchantName String
  /// The total. Server-computed from the items when there are any, so a
  /// client cannot assert a total that does not match its own lines
  /// (FR-SPD-006 applies here for the same reason).
  amount               String
  currency             String
  amountInBaseCurrency String

  /// When the money was spent, which is not when the claim was filed.
  expenseDate DateTime
  memo        String?

  status ExpenseStatus @default(DRAFT)

  /// The decision as it was made, stored verbatim (docs/11 §8).
  policyDecision     Json?
  approvalInstanceId String?

  submittedAt DateTime?
  decidedAt   DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  submitter    Membership    @relation("ExpenseSubmitter", fields: [submitterMembershipId], references: [id])
  entity       Entity        @relation(fields: [entityId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transaction  Transaction?  @relation(fields: [transactionId], references: [id])
  items        ExpenseItem[]

  reimbursementLine ReimbursementLine?

  @@unique([organizationId, reference])
  @@index([organizationId, status, expenseDate])
  @@index([organizationId, submitterMembershipId, status])
  @@index([submitterMembershipId])
  @@index([entityId])
  @@index([departmentId])
  @@index([projectId])
  @@index([categoryId])
  @@index([transactionId])
  @@map("expenses")
}

/// One line of an expense — a meal, a fare, a night in a hotel.
///
/// Optional: most expenses are one thing. They exist for the claim that covers
/// a three-day trip, where one category and one memo would lose exactly the
/// detail finance needs to code it.
model ExpenseItem {
  id             String @id @map("_id")
  organizationId String
  expenseId      String

  description String
  amount      String
  currency    String
  categoryId  String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  expense      Expense      @relation(fields: [expenseId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@index([organizationId, expenseId])
  @@index([expenseId])
  @@index([categoryId])
  @@map("expense_items")
}

/// A batch of approved out-of-pocket expenses, paid as one payment.
///
/// **Grouped by person, entity, currency, and period** (FR-EXP-008). Each is
/// forced: one payment goes to one person, from one legal entity, in one
/// currency — mixing any of them produces a batch nobody can actually pay. The
/// period is what makes a batch a decision rather than a running total.
///
/// The total is computed from the lines, never supplied. A batch whose stated
/// total disagreed with its lines is the kind of number that gets paid and
/// then reconciled by hand for a week.
model ReimbursementBatch {
  id             String @id @map("_id")
  organizationId String

  reference String

  /// Who is being paid.
  payeeMembershipId String
  entityId          String
  currency          String

  /// The window the batch covers, so "March's expenses" is a thing that exists.
  periodStart DateTime
  periodEnd   DateTime

  /// `DRAFT`, `APPROVED`, `PAID`, `CANCELLED`.
  status String @default("DRAFT")

  /// Summed from the lines inside the transaction that writes them.
  totalAmount String @default("0.0000")

  /// Mandatory before a batch can be marked paid (FR-EXP-010). A payment
  /// nobody can find in a bank statement is a payment nobody can prove.
  paymentReference String?
  paidAt           DateTime?
  paidByMembershipId String?

  approvedAt             DateTime?
  approvedByMembershipId String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  payee        Membership          @relation("ReimbursementPayee", fields: [payeeMembershipId], references: [id])
  entity       Entity              @relation(fields: [entityId], references: [id])
  approvedBy   Membership?         @relation("ReimbursementApprover", fields: [approvedByMembershipId], references: [id])
  paidBy       Membership?         @relation("ReimbursementPayer", fields: [paidByMembershipId], references: [id])
  lines        ReimbursementLine[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, payeeMembershipId, status])
  @@index([payeeMembershipId])
  @@index([entityId])
  @@index([approvedByMembershipId])
  @@index([paidByMembershipId])
  @@map("reimbursement_batches")
}

/// One expense inside one batch.
///
/// **`expenseId` is unique across every batch, and that index is the control**
/// (FR-EXP-009). Paying the same claim twice is the most ordinary financial
/// error there is — two people batching on the same afternoon, a retry after a
/// timeout — and it is prevented by the database rather than by a check that
/// two concurrent writers both pass.
model ReimbursementLine {
  id             String @id @map("_id")
  organizationId String
  batchId        String

  expenseId String

  amount   String
  currency String

  createdAt DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id])
  batch        ReimbursementBatch @relation(fields: [batchId], references: [id])
  expense      Expense            @relation(fields: [expenseId], references: [id])

  /// The invariant. One expense, one line, ever — across all batches, not
  /// merely within one.
  @@unique([expenseId])
  @@index([organizationId, batchId])
  @@index([batchId])
  @@map("reimbursement_lines")
}
