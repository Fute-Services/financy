// ═══════════════════════════════════════════════════════════════════════════
//  Financy — Prisma schema (MongoDB)
//
//  ⚠ READ THIS BEFORE CHANGING ANYTHING HERE.
//
//  This schema targets MongoDB at the operator's direction. MongoDB cannot
//  express several guarantees the PostgreSQL schema enforced, and those
//  guarantees have not disappeared — they have **moved into application code**,
//  where they can be bypassed by any write that does not go through the
//  service layer. Each one is marked below.
//
//  What the database no longer enforces:
//
//    · **Cross-tenant references.** PostgreSQL used composite foreign keys
//      `(id, organization_id)` so a membership could not point at another
//      organisation's department even if the code tried. MongoDB has no
//      foreign keys and Prisma's Mongo connector has no multi-field relations,
//      so this is now a check in `TenantGuard` and the repositories.
//    · **CHECK constraints.** The audit actor rule, ISO-4217 and ISO-3166
//      formats, hierarchy self-reference, department path shape, session
//      expiry ordering, and the entity-scope rule are all validated in
//      `packages/contracts` and the services instead.
//    · **Immutability by grant.** `REVOKE UPDATE, DELETE ON audit_events` has
//      no equivalent for a single Atlas application user. `AuditService`
//      exposes no update or delete method, which is a convention rather than
//      a permission.
//    · **Migrations.** Prisma Migrate does not support MongoDB. Schema changes
//      are applied with `prisma db push`, so there is no ordered, reviewed SQL
//      file per change and no expand/contract path (`docs/09 §10`).
//    · **Case-insensitive email.** There is no `citext`. Uniqueness holds only
//      because `emailSchema` lower-cases before writing; a direct database
//      write bypasses it.
//
//  What still holds: unique indexes, compound indexes, `Decimal` for money,
//  and multi-document transactions (Atlas runs a replica set, so registration
//  stays atomic).
//
//  Conventions that remain unchanged:
//    · Primary keys are UUID v7 generated by the application (`newId()`),
//      stored as the string `_id`.
//    · Every business collection carries `organizationId`. `users`, `sessions`,
//      `mfaFactors`, `permissions`, and `rolePermissions` are the deliberate
//      exceptions — a user is a global identity.
//    · Every model must be registered in `src/tenancy/model-registry.ts`.
//    · The first field of every compound index is `organizationId`.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Enumerations
// ═══════════════════════════════════════════════════════════════════════════

/// Which documents a membership's permissions apply to (docs/03 §1.2).
enum MembershipScope {
  SELF
  DEPARTMENT
  ENTITY
  ORGANISATION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum EntityStatus {
  ACTIVE
  ARCHIVED
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

/// Who performed an audited action. `SYSTEM` is a scheduled job, `PROVIDER` an
/// inbound webhook — both legitimately have no membership.
///
/// PostgreSQL enforced "a USER action names its actor" with a CHECK
/// constraint. Here it is enforced by `AuditService.record`, which throws
/// before writing.
enum ActorType {
  USER
  SYSTEM
  PROVIDER
}

enum MfaFactorType {
  TOTP
}

enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  MFA_ENROLLED
  MFA_CHALLENGE_FAILED
  SESSION_REVOKED
  ROLE_CHANGED
  MEMBERSHIP_DEACTIVATED
  TENANT_MISMATCH_ATTEMPTED
  STEP_UP_FAILED
}

// ═══════════════════════════════════════════════════════════════════════════
//  Global — identity that belongs to no single organisation
// ═══════════════════════════════════════════════════════════════════════════

/// The tenant root.
model Organization {
  id   String @id @map("_id")
  /// Unique, and lower-cased by the service before writing. PostgreSQL used
  /// `citext`, which made that a property of the column rather than of the
  /// code path.
  slug String @unique

  name      String
  legalName String?

  /// ISO-4217. Format was a CHECK constraint; it is now `currencyCodeSchema`.
  /// Locked once any financial record exists (`409 CURRENCY_LOCKED`).
  baseCurrency String

  timezone             String @default("UTC")
  fiscalYearStartMonth Int    @default(1)
  /// ISO-3166 alpha-2. Format validated in the contract, not the database.
  countryCode          String

  settings Json @default("{}")

  /// Optimistic concurrency (docs/09 §1.7). A stale `If-Match` is a `409`.
  version Int @default(1)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships    Membership[]
  roles          Role[]
  entities       Entity[]
  departments    Department[]
  projects       Project[]
  categories     Category[]
  invitations    Invitation[]
  auditEvents    AuditEvent[]
  securityEvents SecurityEvent[]

  policies            Policy[]
  policyVersions      PolicyVersion[]
  spendRequests       SpendRequest[]
  approvalInstances   ApprovalInstance[]
  approvalSteps       ApprovalStep[]
  approvalActions     ApprovalAction[]
  approvalDelegations ApprovalDelegation[]

  @@map("organizations")
}

/// A human, globally.
///
/// A user has **no permissions**. A membership does (docs/03 §1).
model User {
  id String @id @map("_id")

  /// Unique. Case-insensitivity comes from `emailSchema` lower-casing before
  /// the write — MongoDB has no `citext`, so `Ada@acme.com` written directly
  /// to the collection would create a second account.
  email String @unique

  /// argon2id. Never logged, never returned, never in an error message.
  passwordHash String

  fullName        String
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Lockout state, counted per account rather than per IP: an attacker
  /// rotates addresses, and the account is what needs protecting.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberships    Membership[]
  sessions       Session[]
  mfaFactors     MfaFactor[]
  securityEvents SecurityEvent[]

  @@map("users")
}

/// The global permission catalogue. Seeded, never written through an API.
model Permission {
  id          String  @id @map("_id")
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

/// A named bundle of permissions, owned by one organisation.
///
/// Per-organisation rather than shared, which was forced by the PostgreSQL
/// composite foreign key and is kept here deliberately even though MongoDB
/// would not force it: a shared role set means a role edit in one tenant is a
/// role edit in every tenant, and there is no way to offer custom roles in
/// Phase 6 without splitting them anyway.
model Role {
  id             String @id @map("_id")
  organizationId String

  key         String
  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

/// Join between a role and a permission.
model RolePermission {
  id           String @id @map("_id")
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  /// PostgreSQL used `(role_id, permission_id)` as the primary key. MongoDB
  /// requires a single `_id`, so the pair becomes a unique index instead —
  /// the duplicate-grant guarantee survives, the shape does not.
  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// An opaque server-side session.
model Session {
  id     String @id @map("_id")
  userId String

  activeMembershipId String?

  /// The **hash** of the token, never the token itself.
  tokenHash Bytes @unique

  ipAddress String?
  userAgent String?

  lastSeenAt DateTime @default(now())

  /// Two expiries, defending against different things: idle against an
  /// unattended browser, absolute against a stolen token living forever.
  ///
  /// PostgreSQL enforced `idle <= absolute` with a CHECK. `SessionService`
  /// clamps instead.
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime

  /// Last successful re-authentication, for the step-up window (docs/12 §4).
  steppedUpAt DateTime?

  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  user             User        @relation(fields: [userId], references: [id])
  activeMembership Membership? @relation(fields: [activeMembershipId], references: [id])

  @@index([userId, revokedAt])
  @@index([activeMembershipId])
  /// Drives the expiry sweep.
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// A second authentication factor. Enrolment UI is Phase 6.
model MfaFactor {
  id     String @id @map("_id")
  userId String

  type MfaFactorType @default(TOTP)

  /// Encrypted with `ENCRYPTION_KEY`. The secret is a password equivalent.
  secretEncrypted Bytes

  /// Hashed, like passwords: a backup code is a credential.
  backupCodeHashes String[] @default([])

  confirmedAt DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("mfa_factors")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Tenant-scoped
//
//  Every relation below was a **composite** foreign key under PostgreSQL,
//  carrying `organizationId` on both sides so a cross-tenant reference was
//  structurally impossible. MongoDB has no foreign keys and Prisma's Mongo
//  connector has no multi-field relations, so each is now a single-field
//  reference that the database will not check at all.
//
//  The predicate in the Prisma tenant extension is what keeps reads inside an
//  organisation. Writes are checked in the services. Neither survives a bug.
// ═══════════════════════════════════════════════════════════════════════════

/// A user's relationship to one organisation.
model Membership {
  id             String @id @map("_id")
  organizationId String
  userId         String
  roleId         String

  departmentId        String?
  managerMembershipId String?

  scope MembershipScope @default(SELF)

  /// Which legal entities this membership may see, when `scope = ENTITY`.
  /// PostgreSQL required at least one via CHECK; the service does now.
  entityScope String[] @default([])

  status        MembershipStatus @default(ACTIVE)
  deactivatedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  department   Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id])

  manager Membership?  @relation("ManagerChain", fields: [managerMembershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports Membership[] @relation("ManagerChain")

  sessions        Session[]
  headOf          Department[]    @relation("DepartmentHead")
  invitationsSent Invitation[]    @relation("InvitedBy")
  auditEvents     AuditEvent[]
  securityEvents  SecurityEvent[]

  policyVersionsAuthored PolicyVersion[]      @relation("PolicyAuthor")
  spendRequests          SpendRequest[]       @relation("SpendRequester")
  approvalActions        ApprovalAction[]     @relation("ApprovalActor")
  approvalActionsOnBehalf ApprovalAction[]    @relation("ApprovalDelegator")
  delegationsGiven       ApprovalDelegation[] @relation("DelegatedFrom")
  delegationsReceived    ApprovalDelegation[] @relation("DelegatedTo")

  /// One membership per user per organisation.
  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, roleId])
  @@index([userId])
  @@index([managerMembershipId])
  @@map("memberships")
}

/// A legal entity, with its own functional currency.
model Entity {
  id             String @id @map("_id")
  organizationId String

  name               String
  registrationNumber String?
  countryCode        String
  functionalCurrency String

  status     EntityStatus @default(ACTIVE)
  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  projects      Project[]
  spendRequests SpendRequest[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("entities")
}

/// The department tree.
model Department {
  id             String  @id @map("_id")
  organizationId String
  parentId       String?

  name String
  code String?

  headMembershipId String?

  /// Materialised ancestry, `/root-id/child-id/`, maintained by the service.
  ///
  /// Subtree reads are `path startsWith '/a/b/'`. PostgreSQL had a CHECK that
  /// the path was delimited at both ends, because an undelimited one makes
  /// '/a/bc/' match a query for '/a/b/' and silently widens a manager's scope.
  /// That check is now in the department service.
  path String

  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Department[] @relation("DepartmentTree")

  /// `NoAction` breaks the cycle Prisma detects: a membership points at its
  /// department, and a department points at its head membership. Referential
  /// actions are advisory here anyway — MongoDB does not enforce them — so
  /// the head is cleared by the service when a membership is deactivated.
  head    Membership?  @relation("DepartmentHead", fields: [headMembershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members Membership[] @relation("DepartmentMembers")

  projects      Project[]
  spendRequests SpendRequest[]

  /// **Not** unique on (organizationId, code), though PostgreSQL made it so.
  /// MongoDB treats every missing or null value in a unique index as the same
  /// value, so a second row without a code collides with the first — an
  /// organisation could have exactly one uncoded department, which is not a
  /// rule anybody asked for. Uniqueness of a code that *is* set is enforced by
  /// the service instead.
  @@index([organizationId, code])
  @@index([organizationId, parentId])
  @@index([organizationId, path])
  @@index([headMembershipId])
  @@map("departments")
}

/// An optional cost dimension.
model Project {
  id             String @id @map("_id")
  organizationId String

  name String
  code String?

  entityId     String?
  departmentId String?

  status     ProjectStatus @default(ACTIVE)
  startsOn   DateTime?
  endsOn     DateTime?
  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  entity        Entity?        @relation(fields: [entityId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  spendRequests SpendRequest[]

  /// **Not** unique on (organizationId, code), though PostgreSQL made it so.
  /// MongoDB treats every missing or null value in a unique index as the same
  /// value, so a second row without a code collides with the first — an
  /// organisation could have exactly one uncoded department, which is not a
  /// rule anybody asked for. Uniqueness of a code that *is* set is enforced by
  /// the service instead.
  @@index([organizationId, code])
  @@index([organizationId, status])
  @@index([entityId])
  @@index([departmentId])
  @@map("projects")
}

/// The spend category tree.
model Category {
  id             String  @id @map("_id")
  organizationId String
  parentId       String?

  key  String
  name String

  /// Seeded categories are marked, so a deploy never overwrites an
  /// organisation's own.
  isSystem Boolean @default(false)

  archivedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  spendRequests SpendRequest[]

  @@unique([organizationId, key])
  @@index([organizationId, parentId])
  @@map("categories")
}

/// An invitation to join an organisation.
model Invitation {
  id             String @id @map("_id")
  organizationId String

  email  String
  roleId String

  departmentId String?

  invitedByMembershipId String

  /// Hashed, single-use, expiring. The plaintext exists only in the email.
  tokenHash Bytes @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  /// Soft delete: an invitation that was sent is evidence, even once spent.
  deletedAt DateTime?

  resentCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    Membership   @relation("InvitedBy", fields: [invitedByMembershipId], references: [id])

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
  @@index([roleId])
  @@index([invitedByMembershipId])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════════════════════════════
//  The record that is supposed to be immutable
//
//  Under PostgreSQL the application role had no UPDATE or DELETE grant on
//  these two tables, so tampering failed at the database regardless of what
//  the code did. A single Atlas application user cannot express that, so
//  immutability here rests on `AuditService` and `SecurityEventService`
//  exposing no method that could rewrite a row. That is a convention. It is
//  weaker, and it is the most significant thing lost in this migration.
// ═══════════════════════════════════════════════════════════════════════════

/// Every privileged or financial mutation, written inside the caller's
/// transaction (docs/09 §7.1).
model AuditEvent {
  id             String @id @map("_id")
  organizationId String

  /// Null only when `actorType` is not `USER`. PostgreSQL enforced that with
  /// the `audit_actor_present` CHECK; `AuditService.record` throws instead.
  actorMembershipId String?
  actorType         ActorType @default(USER)
  /// The job name or provider name, when the actor is not a person.
  actorLabel        String?

  /// `spend_request.approved`, `membership.role_changed`, …
  action       String
  resourceType String
  resourceId   String?

  /// The change itself. Both null for a read-style event such as an export.
  before Json?
  after  Json?

  metadata Json @default("{}")

  ipAddress String?
  userAgent String?

  /// Joins the event to the request that produced it, and to every log line
  /// that request emitted.
  correlationId String

  createdAt DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  actorMembership Membership?  @relation(fields: [actorMembershipId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId, createdAt(sort: Desc)])
  @@index([organizationId, actorMembershipId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// Who tried, as opposed to what changed (docs/12 §7).
model SecurityEvent {
  id             String @id @map("_id")
  organizationId String

  type SecurityEventType

  /// Both optional: a failed login for an unknown email has neither.
  userId       String?
  membershipId String?

  ipAddress String?
  userAgent String?

  metadata Json @default("{}")

  correlationId String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  membership   Membership?  @relation(fields: [membershipId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, type, createdAt(sort: Desc)])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("security_events")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Phase 2 — policy, approvals, spend requests
//
//  Two shapes here are unusual and both are deliberate.
//
//  **A policy version stores its rules as JSON, not as rows.** `policy_rules`
//  exists in the PostgreSQL design as a child table; here the version carries
//  a `snapshot` containing the whole rule set, validated by
//  `policyVersionSchema` on the way in. The reason is immutability: a version
//  is frozen the moment it is published, and a decision made under it must
//  remain explicable years later. Rules as rows can be edited one at a time by
//  anything holding a connection; a snapshot cannot be half-changed.
//
//  **Every spend record keeps its `policy_decision` verbatim.** It is never
//  recomputed for display. The screen answering "why did this need three
//  approvals?" reads the snapshot taken at submission, under the engine
//  version recorded in it — recomputing would answer with today's policy and
//  quietly be wrong about the past.
// ═══════════════════════════════════════════════════════════════════════════

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SpendType {
  CARD
  REIMBURSEMENT
  BILL
  PURCHASE_ORDER
  SPEND_REQUEST
}

/// A named spending policy. Its rules live on its versions.
model Policy {
  id             String @id @map("_id")
  organizationId String

  name        String
  description String?

  /// Which spend types this policy applies to. An empty list means none, not
  /// all — a policy that applied to everything by omission would be a policy
  /// nobody meant to write.
  spendTypes SpendType[]

  /// Higher runs first. Ties are broken by policy id in the evaluator, never
  /// by insertion order (docs/11 §5).
  priority Int @default(100)

  status PolicyStatus @default(DRAFT)

  /// The published version. Null while the policy has only drafts.
  currentVersionId String?

  effectiveFrom DateTime?
  effectiveTo   DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  versions     PolicyVersion[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("policies")
}

/// One frozen revision of a policy's rules.
model PolicyVersion {
  id             String @id @map("_id")
  organizationId String
  policyId       String

  version Int

  /// The complete rule set, validated by `policyVersionSchema` before it is
  /// written. Frozen on publication — see the note at the top of this block.
  snapshot Json

  createdByMembershipId String?

  /// Why these rules changed. Written at publication and read by whoever asks,
  /// six months later, why a decision citing this version came out as it did —
  /// the only free-text record of intent a rule set carries.
  note String?

  /// Published, and therefore immutable. A draft version may still change.
  publishedAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  policy       Policy       @relation(fields: [policyId], references: [id])
  createdBy    Membership?  @relation("PolicyAuthor", fields: [createdByMembershipId], references: [id])

  @@unique([policyId, version])
  @@index([organizationId, policyId])
  @@map("policy_versions")
}

enum SpendRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

/// A request to spend money, before any money moves.
model SpendRequest {
  id             String @id @map("_id")
  organizationId String

  /// Human-facing, unique per organisation — the thing people quote to each
  /// other. Numbered within the organisation rather than globally, so one
  /// customer's volume is not visible to another.
  reference String

  requesterMembershipId String

  entityId     String
  departmentId String?
  projectId    String?
  categoryId   String?
  vendorId     String?

  spendType SpendType @default(SPEND_REQUEST)

  /// A decimal string. Prisma's MongoDB connector has no `Decimal`, and a
  /// float amount is a rounding error waiting for a total (ADR-0017).
  amount   String
  currency String

  /// The same amount in the organisation's base currency, converted at a
  /// recorded rate. Policies are authored against this so that a rule never
  /// has to compare across currencies.
  amountInBaseCurrency String
  exchangeRate         String?

  purpose  String
  memo     String?
  neededBy DateTime?

  status SpendRequestStatus @default(DRAFT)

  /// The decision, verbatim, as it was made. Never recomputed.
  policyDecision Json?

  approvalInstanceId String?

  validUntil  DateTime?
  submittedAt DateTime?
  decidedAt   DateTime?

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  requester    Membership   @relation("SpendRequester", fields: [requesterMembershipId], references: [id])
  entity       Entity       @relation(fields: [entityId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([organizationId, requesterMembershipId, status])
  @@index([organizationId, departmentId, status])
  @@index([requesterMembershipId])
  @@index([entityId])
  @@index([departmentId])
  @@index([projectId])
  @@index([categoryId])
  @@map("spend_requests")
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ApprovalStepStatus {
  WAITING
  ACTIVE
  APPROVED
  REJECTED
  SKIPPED
  EXPIRED
}

enum ApprovalStepType {
  SINGLE
  PARALLEL_ANY
  PARALLEL_ALL
  QUORUM
}

enum ApprovalActionType {
  APPROVE
  REJECT
  RETURN
  DELEGATE
  OVERRIDE
}

/// One approval chain, for one subject.
model ApprovalInstance {
  id             String @id @map("_id")
  organizationId String

  /// `spend_request`, `expense`, `bill`, `purchase_order`. Polymorphic rather
  /// than one instance table per subject, because the state machine, the
  /// actions, and the queue endpoint are identical for all of them and three
  /// copies would drift.
  subjectType String
  subjectId   String

  status ApprovalInstanceStatus @default(PENDING)

  currentStepSequence Int @default(1)

  /// A copy of the decision the chain was built from. The instance outlives
  /// the policy version that produced it, and "why was this the chain?" has
  /// to stay answerable after the policy changes.
  policyDecisionSnapshot Json

  completedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  steps        ApprovalStep[]

  @@index([organizationId, status])
  @@index([organizationId, subjectType, subjectId])
  @@map("approval_instances")
}

model ApprovalStep {
  id                 String @id @map("_id")
  organizationId     String
  approvalInstanceId String

  sequence Int
  stepType ApprovalStepType

  /// How many approvals a `QUORUM` step needs. Ignored by the other types.
  quorum Int @default(1)

  status ApprovalStepStatus @default(WAITING)

  /// The memberships eligible to act, resolved from the approver specs when
  /// the chain was built. Stored rather than re-resolved: somebody eligible
  /// when the request was raised stays eligible, so a reorganisation midway
  /// through does not silently move the decision to another person.
  eligibleMembershipIds String[] @default([])

  activatedAt DateTime?
  dueAt       DateTime?
  completedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  instance     ApprovalInstance @relation(fields: [approvalInstanceId], references: [id])
  actions      ApprovalAction[]

  @@unique([approvalInstanceId, sequence])
  @@index([organizationId, status])
  @@index([approvalInstanceId])
  @@map("approval_steps")
}

/// What somebody did to a step. Append-only, like the audit trail.
model ApprovalAction {
  id             String @id @map("_id")
  organizationId String
  approvalStepId String

  actedByMembershipId String

  /// Set when the actor was using delegated authority, so the record shows
  /// both who pressed the button and whose authority they used.
  onBehalfOfMembershipId String?

  action  ApprovalActionType
  comment String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  step         ApprovalStep @relation(fields: [approvalStepId], references: [id])
  actedBy      Membership   @relation("ApprovalActor", fields: [actedByMembershipId], references: [id])
  onBehalfOf   Membership?  @relation("ApprovalDelegator", fields: [onBehalfOfMembershipId], references: [id])

  @@index([organizationId, approvalStepId])
  @@index([actedByMembershipId])
  @@index([onBehalfOfMembershipId])
  @@map("approval_actions")
}

/// One person's approval authority, lent to another for a period.
model ApprovalDelegation {
  id             String @id @map("_id")
  organizationId String

  fromMembershipId String
  toMembershipId   String

  startsAt DateTime
  endsAt   DateTime

  reason String?

  revokedAt DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  from         Membership   @relation("DelegatedFrom", fields: [fromMembershipId], references: [id])
  to           Membership   @relation("DelegatedTo", fields: [toMembershipId], references: [id])

  @@index([organizationId, fromMembershipId])
  @@index([organizationId, toMembershipId])
  @@index([toMembershipId])
  @@map("approval_delegations")
}
