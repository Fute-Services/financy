# ─── Secrets — never commit ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ─── Dependencies ────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build output ────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ─── Test output ─────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Screenshots taken while checking a change locally. Useful to look at,
# never worth committing.
.shots/

# ─── Local storage (LocalDocumentProvider) ───────────────────
.storage/

# ─── Prisma ──────────────────────────────────────────────────
packages/db/prisma/generated/
packages/db/prisma/*.db
packages/db/prisma/*.db-journal

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editor / OS ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Misc ────────────────────────────────────────────────────
.cache/
tmp/
temp/

# Compiled output that once landed beside its source. `packages/db/test` had
# .js and .d.ts files committed next to the .ts, which broke lint (the parser
# is given a project that does not list them) and silently shadowed edits.
packages/*/test/*.js
packages/*/test/*.d.ts
packages/*/test/*.map

# Vercel's project link. It holds the project and org ids for this checkout,
# which are per-machine rather than per-repo — `vercel link` recreates them.
.vercel
