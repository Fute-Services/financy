# ─── Secrets — never commit ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ─── Dependencies ────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build output ────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ─── Test output ─────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# ─── Local storage (LocalDocumentProvider) ───────────────────
.storage/

# ─── Prisma ──────────────────────────────────────────────────
packages/db/prisma/generated/
packages/db/prisma/*.db
packages/db/prisma/*.db-journal

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editor / OS ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Misc ────────────────────────────────────────────────────
.cache/
tmp/
temp/
