# The development host is Windows with no WSL (see docs/REPOSITORY_AUDIT.md P4).
# Normalise everything to LF in the repository so CI (Linux) and local (Windows) agree.

* text=auto eol=lf

*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.mmd     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.prisma  text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.sh      text eol=lf
*.env*    text eol=lf

# Windows-only scripts keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.woff    binary
*.woff2   binary

# Lockfile: generated, collapse in diffs
pnpm-lock.yaml -diff linguist-generated=true
