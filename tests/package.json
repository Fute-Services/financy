{
  "name": "@financy/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-cutting end-to-end and security suites. Drives the real stack through a real browser.",
  "scripts": {
    "lint": "eslint specs playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@financy/e2e: run with pnpm test:e2e — it needs a running stack\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "install:browsers": "playwright install --with-deps chromium",
    "clean": "node -e \"require('fs').rmSync('playwright-report',{recursive:true,force:true});require('fs').rmSync('test-results',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@financy/config": "workspace:*",
    "@financy/contracts": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
