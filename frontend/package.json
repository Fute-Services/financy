{
  "name": "@financy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node ../scripts/free-ports.mjs --free --only web && next dev --port 3100",
    "dev": "next dev --port 3100",
    "build": "next build",
    "start:prod": "next start --port 3100",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@financy/web: component tests land with Phase 1 task 1.7\"",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@financy/contracts": "workspace:*",
    "@financy/core": "workspace:*",
    "@financy/ui": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@financy/config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
