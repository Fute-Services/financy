# ═══════════════════════════════════════════════════════════════════════════
#  Financy — environment configuration
#
#  Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
#  Every variable here is validated by a Zod schema at startup; a missing or
#  malformed value crashes the process immediately rather than failing later
#  under load. See docs/17-DEPLOYMENT.md §3.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
APP_ENV=local                        # local | test | development | staging | production

# Ports 3000 and 5433 are occupied on the reference dev host (audit finding P2),
# so the project standardises on 3100 / 4100. See ADR-0009.
API_PORT=4100
WEB_PORT=3100
# Loopback by address, not by name.
#
# On Windows, `localhost` resolves to `::1` before `127.0.0.1`, and the IPv6
# attempt costs about 210 ms per connection before it falls back — measured, on
# this machine, on every single request. The web server makes several API calls
# per page render, so that was most of a second of pure connect overhead on
# every page. Naming the address skips the resolution entirely.
API_BASE_URL=http://127.0.0.1:4100
WEB_BASE_URL=http://localhost:3100

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3100

# ─── Database ──────────────────────────────────────────────────────────────
# MongoDB, temporarily. PostgreSQL is still the design — see ADR-0017 in
# docs/20 for what that costs and what has to be restored when it returns.
#
# Whatever you point this at must be a **replica set**. Every write path here
# runs inside an interactive transaction, and MongoDB has none on a standalone
# server: a single-node replica set is enough, and Atlas is one already.
#
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/financy_dev
#   Local:  mongodb://localhost:27017/financy_dev?directConnection=true
#           (docker run -p 27017:27017 mongodb/mongodb-atlas-local)
#
# Never the admin or root user, in any environment. Create a user scoped to
# this database with readWrite and nothing more.
DATABASE_URL=mongodb://localhost:27017/financy_dev?directConnection=true
DATABASE_TEST_URL=mongodb://localhost:27017/financy_test?directConnection=true
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ─── Sessions & cryptography ───────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_COOKIE_NAME=financy_session
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_SECRET=CHANGE_ME_32_BYTES_BASE64
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64
SIGNED_URL_SECRET=CHANGE_ME_32_BYTES_BASE64
STEP_UP_WINDOW_MINUTES=5

# ─── Queue ─────────────────────────────────────────────────────────────────
# Empty REDIS_URL selects the InlineQueueAdapter (in-process, runs after
# commit). That is a development and test convenience only — a production
# APP_ENV with no REDIS_URL FAILS STARTUP. See ADR-0006.
REDIS_URL=
QUEUE_PREFIX=financy

# ─── Object storage ────────────────────────────────────────────────────────
# local  → LocalDocumentProvider: files under STORAGE_LOCAL_PATH, with
#          HMAC-signed expiring URLs served by the API (emulates S3 semantics).
# s3     → S3DocumentProvider.
# DOCUMENT_PROVIDER=local in production FAILS STARTUP. See ADR-0008.
DOCUMENT_PROVIDER=local
STORAGE_LOCAL_PATH=./.storage
STORAGE_MAX_UPLOAD_BYTES=20971520
STORAGE_SIGNED_URL_TTL_SECONDS=900
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Providers ─────────────────────────────────────────────────────────────
# Sandbox adapters set isSandbox=true, which surfaces in API responses and as
# a visible badge in the UI. The product never implies money moved when only a
# record was created. See docs/13-INTEGRATIONS.md §12.
CARD_PROVIDER=mock                   # mock
PAYMENT_PROVIDER=manual              # manual
ACCOUNTING_PROVIDER=csv              # csv
OCR_PROVIDER=noop                    # noop
NOTIFICATION_PROVIDER=console        # console | smtp
IDENTITY_PROVIDER=local              # local
FX_RATE_PROVIDER=static              # static

SMTP_URL=
MAIL_FROM="Financy <no-reply@example.test>"

# ─── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=debug                      # fatal | error | warn | info | debug | trace
LOG_PRETTY=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=financy-api
SENTRY_DSN=

# ─── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ─── Feature flags ─────────────────────────────────────────────────────────
FEATURE_MFA_ENROLLMENT=false         # Phase 6
FEATURE_RLS_ENFORCED=false           # Phase 6
